# PolyAgent .env.example
#
# Copy this file to `.env`. Everything below is OPTIONAL.
# The dashboard runs in DEMO / PAPER_TRADING mode regardless.

# -- Trading mode (web layer ignores LIVE/REAL; CLI honors it explicitly) --
POLYAGENT_MODE=PAPER_TRADING

# -- AI providers (set ONE to enable AI analysis in the dashboard) --
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# -- Backend server config --
API_HOST=0.0.0.0
API_PORT=8000
# API_RELOAD=1   # set non-empty to enable uvicorn --reload locally

# -- Existing CLI keys (preserve any you already had below) --
# POLYMARKET_API_KEY=
# POLYMARKET_PRIVATE_KEY=
